# Copy to .env (never commit .env). Placeholder values only.

# --- Required ---
PORT=4000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskboard?schema=public"
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret"
# Where the Next.js app runs (scheme + host + port, no trailing path)
CLIENT_ORIGIN="http://localhost:3000"

# --- Tests only: a SEPARATE database whose name ends in _test (tests wipe it) ---
#   createdb taskboard_test
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/taskboard_test?schema=public"

# --- Optional (defaults shown) ---
# JWT_EXPIRES_IN_DAYS=7
# BCRYPT_ROUNDS=12
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# Number of reverse proxies in front of the API (1 on Render/Railway)
# TRUST_PROXY=0
# Cookie SameSite: defaults to "lax" in development and "none" (+Secure) in production
# COOKIE_SAME_SITE=lax
