// Agile Task Board — relational schema (PostgreSQL)
//
// Conventions
//  - Table names are plural snake_case via @@map; model names stay PascalCase.
//  - IDs are UUID strings generated by Prisma (matches the existing frontend, which already uses string IDs).
//  - `position` is a dense 0-based integer, rewritten inside a transaction by the service layer.
//    It is deliberately NOT a DB unique constraint: Postgres checks UNIQUE per row (not per statement)
//    unless DEFERRABLE, which Prisma can't express, so a swap would fail mid-update.
//    Ordering integrity is enforced in one place (the reorder/move services) + the indexes below.
//  - Delete behaviour is chosen per relation (see onDelete on each one), not blanket Cascade.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs" // backend compiles to CommonJS
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityAction {
  TASK_CREATED
  TASK_UPDATED
  TASK_DELETED
  TASK_MOVED
  TASK_ASSIGNED
  COLUMN_CREATED
  COLUMN_RENAMED
  COLUMN_DELETED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  COMMENT_ADDED
}

enum ActivityEntityType {
  BOARD
  COLUMN
  TASK
  COMMENT
  MEMBER
}

// ───────────────────────────── Models ─────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255) // stored lowercased by the auth service; @unique also gives the lookup index
  passwordHash String   @db.VarChar(255) // bcrypt hash only, never the password
  avatar       String?  @db.VarChar(2048)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedBoards   Board[]       @relation("BoardOwner")
  memberships   BoardMember[]
  createdTasks  Task[]        @relation("TaskCreator")
  assignedTasks Task[]        @relation("TaskAssignee")
  comments      Comment[]
  activities    ActivityLog[]

  @@map("users")
}

model Board {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Restrict: a user who owns boards can't be deleted until ownership is transferred/boards deleted.
  owner      User          @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members    BoardMember[]
  columns    Column[]
  tasks      Task[]
  activities ActivityLog[]

  @@index([ownerId])
  @@map("boards")
}

// Invariant (kept by the board service, in a transaction): the board owner always has an OWNER row here.
model BoardMember {
  id        String    @id @default(uuid())
  boardId   String
  userId    String
  role      BoardRole @default(MEMBER)
  createdAt DateTime  @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade) // membership is meaningless without the board
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade) // ...or without the user

  // The unique index's leading column is boardId, so a separate boardId index would be redundant.
  @@unique([boardId, userId])
  @@index([userId]) // "which boards does this user belong to?"
  @@map("board_members")
}

model Column {
  id        String   @id @default(uuid())
  boardId   String
  title     String   @db.VarChar(100)
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  // Target for Task's composite FK (see Task) so a task can never point at a column of another board.
  @@unique([id, boardId])
  @@index([boardId, position])
  @@map("columns")
}

model Task {
  id          String       @id @default(uuid())
  boardId     String // denormalised from column for cheap board-wide queries/authorisation; integrity enforced by composite FK below
  columnId    String
  title       String       @db.VarChar(200)
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?
  createdById String
  position    Int
  dueDate     DateTime?    @db.Date // calendar date, no time zone
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  // Composite FK (columnId, boardId) -> columns(id, boardId): DB guarantees task.boardId == column.boardId.
  // Cascade: deleting a column deletes its tasks (same behaviour as the existing UI's deleteColumn).
  column    Column    @relation(fields: [columnId, boardId], references: [id, boardId], onDelete: Cascade)
  // SetNull: removing a user just unassigns their tasks.
  assignee  User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Restrict: authorship is history; don't silently lose it.
  createdBy User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments  Comment[]

  @@index([boardId])
  @@index([columnId, position])
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("comments")
}

model ActivityLog {
  id         String             @id @default(uuid())
  boardId    String
  userId     String
  action     ActivityAction
  entityType ActivityEntityType
  entityId   String // polymorphic reference (task/column/comment/member id) — intentionally no FK so history survives deletes
  metadata   Json? // e.g. { taskTitle, fromColumn, toColumn } snapshot at the time of the event
  createdAt  DateTime           @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([boardId, createdAt(sort: Desc)]) // activity feed: newest first per board
  @@map("activity_logs")
}
